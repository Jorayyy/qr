# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma). Use a pooled URL on serverless hosts.
DATABASE_URL="postgresql://user:password@host:5432/vms?sslmode=require"

# Secret used to encrypt MFA secrets and derive HMAC keys.
# MUST be at least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# ── Sessions ──────────────────────────────────────────────────────────────────
# Idle timeout (minutes) before a session must re-authenticate.
SESSION_IDLE_MINUTES=120
# Absolute session lifetime (hours) regardless of activity.
SESSION_ABSOLUTE_HOURS=16

# ── Rate limiting (requests per window; optional, defaults shown) ─────────────
RATE_LOGIN_IP=10
RATE_LOGIN_ACCOUNT=5
RATE_MFA=5
RATE_PASSWORD_CHANGE=5
RATE_LOOKUP_IP=30
RATE_LOOKUP_QR=10
RATE_LOOKUP_USER=120
RATE_CHECKIN_IP=30
RATE_CHECKIN_USER=120
RATE_REGISTER_IP=30
RATE_REGISTER_USER=120
RATE_REGISTER_GLOBAL=600
RATE_SEARCH_USER=60
RATE_DEPARTMENTS_IP=120

# ── Seed (prisma/seed.ts) ─────────────────────────────────────────────────────
# Initial admin/security passwords. If unset, strong random passwords are
# generated and printed once to the terminal during seeding.
# SEED_ADMIN_PASSWORD=""
# SEED_SECURITY_PASSWORD=""

# ── Retention (npm run purge) ─────────────────────────────────────────────────
# Days to keep audit log entries and expired sessions.
AUDIT_RETENTION_DAYS=365
SESSION_RETENTION_DAYS=30

# ── Email (QR codes to visitors) ──────────────────────────────────────────────
# Two transports, tried in this order. Leave both unset to disable emailing;
# registration then only shows/downloads the QR on screen.
#
# 1) SMTP (preferred) — a dedicated mailbox, no third-party service. For Gmail,
#    enable 2-Step Verification, then Google Account → Security → 2-Step
#    Verification → App passwords and paste the 16-character result.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your.dedicated.address@gmail.com"
SMTP_PASS="your-16-character-app-password"
# Friendly name the visitor sees. Gmail only accepts From addresses that match
# the authenticated mailbox (a display name in front is fine).
EMAIL_FROM="EVSU Visitor Management <your.dedicated.address@gmail.com>"

# 2) Resend API — used only when SMTP_USER/SMTP_PASS are unset. Needs a domain
#    verified in Resend; its default resend.dev sender only delivers to your own
#    account email, so real visitors would never receive these.
# RESEND_API_KEY=""
